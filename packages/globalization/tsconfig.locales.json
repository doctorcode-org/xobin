{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/locales",
    "rootDir": "./locales",
    "target": "es2022",
    "paths": {
      "@xobin/globalization/locales/*": [
        "./locales/*"
      ]
    },
    "sourceMap": false,
    "module": "Node16",
    "moduleResolution": "Node16"
  },
  "include": [
    "./locales/**/*.ts"
  ]
}
