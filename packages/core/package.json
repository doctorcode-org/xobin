{
  "name": "@xobin/core",
  "version": "2.0.0",
  "description": "The package contains shared classes, types, functions and utils.",
  "author": "DoctorCode Team",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./internal/exception-format": {
      "types": "./dist/internal/exception_format.d.ts",
      "import": "./dist/internal/exception_format.mjs",
      "require": "./dist/internal/exception_format.js"
    },
    "./internal/exception-resources": {
      "types": "./dist/internal/exception_resources.d.ts",
      "import": "./dist/internal/exception_resources.mjs",
      "require": "./dist/internal/exception_resources.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/doctorcode-org/xobin.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../tools/release.mjs check core"
  },
  "bugs": {
    "url": "https://github.com/doctorcode-org/xobin/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/doctorcode-org/xobin#readme",
  "keywords": [
    "xobin",
    "typescript",
    "exceptions"
  ]
}
